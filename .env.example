NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Transactional email (Scaleway Transactional Email, EU), used by src/lib/email/sendEmail.ts
# SCW_SECRET_KEY = secret key of an API key with TransactionalEmail permissions (store as Sensitive in Vercel)
SCW_SECRET_KEY=
SCW_PROJECT_ID=
# Optional sender override (must be on a domain verified in Scaleway).
# Default: Solarpunk Taskforce <no-reply@solarpunktaskforce.org>
EMAIL_FROM=
# IATI sync (scripts/iati/sync.ts), runs in GitHub Actions only; store these as GitHub Actions secrets, not in Vercel.
# IATI_API_KEY = subscription key from developer.iatistandard.org (Datastore API)
IATI_API_KEY=
# SUPABASE_DB_URL = Postgres connection string (also used by supabase-db-auto); bypasses RLS, never expose it
SUPABASE_DB_URL=
# AI (Mistral AI, Paris), used by src/lib/ai/: AI project search (members) and automatic project tags.
# Without MISTRAL_API_KEY both features stay switched off. Store as Sensitive in Vercel.
MISTRAL_API_KEY=
# Optional: model (default mistral-small-latest) and AI searches per person per day (default 30)
MISTRAL_MODEL=
AI_SEARCH_DAILY_LIMIT=
# Supabase service role key (Project settings -> API). Server only, needed for AI tags and the AI usage log.
# Bypasses RLS: Sensitive in Vercel, never in client code or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
